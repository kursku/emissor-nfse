# ============================================================
# PRESTADOR — dados cadastrais da empresa emissora da nota
# ============================================================

# CNPJ do prestador de serviço, somente dígitos (14 números, sem pontuação)
NFSE_CNPJ=

# Inscrição Municipal (IM) da empresa na prefeitura
NFSE_IM=

# Sigla do estado (UF) do município do prestador, ex.: SP
NFSE_UF=

# Código IBGE do município do prestador, com 7 dígitos
NFSE_COD_MUNICIPIO=

# ============================================================
# CERTIFICADO DIGITAL — certificado A1 e-CNPJ usado para assinar a nota
# ============================================================

# Caminho absoluto do arquivo do certificado digital A1 (.p12 ou .pfx)
# Ex.: C:/caminho/para/certificado.p12
NFSE_CERT_PATH=

# Senha do arquivo do certificado (.p12/.pfx)
NFSE_CERT_PASSWORD=

# Pasta onde os XMLs, PDFs e logs de emissão serão gravados (opcional)
# Padrão se vazio: <projeto>/output/nfewizard
NFSE_OUTPUT_DIR=

# Ambiente de emissão: 1 = produção (nota real, irreversível), 2 = homologação/produção restrita
# (opcional, padrão 2 = produção restrita. Emitir de verdade exige escrever 1 aqui.)
NFSE_AMBIENTE=

# ============================================================
# TRIBUTAÇÃO — regime tributário e enquadramento no Simples Nacional
# ============================================================

# Opção pelo Simples Nacional: 1 = não optante, 2 = MEI, 3 = ME/EPP (opcional, padrão 3)
NFSE_OP_SIMP_NAC=

# Regime de apuração do Simples quando ME/EPP: 1 = federais e municipal pelo SN,
# 2 = federais pelo SN e ISS por fora, 3 = federais pelo SN e ISS fixo (opcional, padrão 1)
NFSE_REG_AP_TRIB_SN=

# Regime especial de tributação: 0 = nenhum (opcional, padrão 0)
NFSE_REG_ESP_TRIB=

# Percentual aproximado de tributos do Simples Nacional (Lei da Transparência) —
# é a alíquota inicial do anexo do serviço prestado. Ex.: Anexo III = 6.00, Anexo V = 15.50
# (opcional, padrão 6.00). Confirme o anexo correto com o contador.
NFSE_P_TOT_TRIB_SN=

# ============================================================
# E-MAIL — envio automático do DANFSe (PDF da nota) ao cliente
# ============================================================

# Chave da API do Resend (opcional; sem ela a emissão funciona, só não envia e-mail)
RESEND_API_KEY=

# E-mail remetente configurado no Resend, ex.: notas@seudominio.com.br (opcional)
RESEND_FROM_NOTAS=
